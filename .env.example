# Supabase (obrigatório)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Rota no mapa da tela Entregas (opcional — use uma das duas)
# 1ª opção: Google Routes API — rota com trânsito em tempo real (pago, tem crédito grátis mensal)
VITE_GOOGLE_MAPS_API_KEY=
# 2ª opção: OpenRouteService — rota mais curta, sem trânsito (grátis)
VITE_ORS_API_KEY=
